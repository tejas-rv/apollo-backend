# Copy to .env (git-ignored). Real env vars / IntelliJ run-config vars override these.
# Non-secret settings already have working defaults in application.yml; set them here only to override.
APP_MASTER_KEY=
DB_URL=jdbc:postgresql://<host>/<db>?sslmode=require
DB_USERNAME=
DB_PASSWORD=
MAIL_PASSWORD=<gmail-app-password>
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
